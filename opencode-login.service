[Unit]
Description=OpenCode Web Login
Requires=opencode.service
PartOf=opencode.service
After=network.target opencode.service

[Service]
Type=simple
User=opencode-login
Group=opencode-login
WorkingDirectory=/opt/opencode-login
EnvironmentFile=-/etc/opencode-login.env
StateDirectory=opencode-login
StateDirectoryMode=0700
ExecStart=/usr/local/bin/node /opt/opencode-login/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryMax=256M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
