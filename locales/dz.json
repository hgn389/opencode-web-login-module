  "m047": "མཉམ་བསྡོམས་ཐོ་ཡིག་འདི་ {0} དཔེ་ཚད་ཚུ་ལས་ལྷག་སྟེ་ཡོདཔ་ཨིན། ལོག་སྟེ་པར་བཤུས་མ་རྐྱབ་པའི་ཧེ་མ་ དཔེ་ཚད་ལ་ལོ་ཅིག་རྩ་བསྐྲད་གཏང་།",
  "m048": "{0} དཔེ་ཚད་ཚུ་ཐོབ་ཡོདཔ།; འབྲི་ཤོག་ནང་ལུ་ {1} དཔེ་ཚད་གསརཔ་ཁ་སྐོང་འབད་ཡོདཔ།{2} ད་ལྟོ་ཡོད་པའི་མིང་དང་སེལ་འཐུ་ཚུ་ ཉམས་སྲུང་འབད་ཡོདཔ་ཨིན། རིམ་སྒྲིག་སྲུང་བཞག་མ་འབད་བས།",
  "m049": " {0} འདྲ་བཤུས་ཡང་ན་ནུས་མེད་ཐོ་བཀོད་ཚུ་གོམ་འགྱོ་ཡོདཔ།",
  "m050": "དཔེ་སྟོན་བརྟག་དཔྱད་མཇུག་བསྡུ་ཡོདཔ། ཆ་མཉམ་སེལ་འཐུ་འབད་ ཡང་ན་ ཆ་མཉམ་ཞིབ་དཔྱད་འབད་བཤོལ་ ལག་ལེན་འཐབ་ ཁྱོད་ལུ་དགོ་པའི་དཔེ་ཚད་ཚུ་གདམ་ཁ་རྐྱབ་ཞིནམ་ལས་ བྱིན་མི་འདི་སྲུང་བཞག་འབད།",
  "m051": "ཁྱོད་རའི་ད་ལྟོའི་ཆོག་ཡིག་བཙུགས་ཞིནམ་ལས་ སྲུང་བཞག་ཡང་ན་བཏོན་མ་གཏང་པའི་ཧེ་མ་ རིམ་སྒྲིག་ལོག་མངོན་གསལ་འབད་ནི་ལུ་ ཁྱོད་རའི་གནང་བ་ངེས་དཔྱད་འབད།",
  "m052": "བྱིན་མི་འདི་སྲུང་བཞག་མ་འབད་བའི་ཧེ་མ་ ཉུང་མཐའ་དཔེ་ཚད་གཅིག་སེལ་འཐུ་འབད།",
