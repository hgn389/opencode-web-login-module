  "m058": "བདེན་དཔྱད་ཨང་རྟགས་འདི་དུས་ཚོད་རྫོགས་ཡོདཔ། ཨང་རྟགས་གསརཔ་བཙུགས་གནང་།",
  "m059": "མཐུད་ལམ་འདི་འགོར་འགྱངས་ཨིན། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m060": "སར་བར་ལུ་མཐུད་མ་ཚུགས། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m062": "ནུས་མེད་ནང་བསྐྱོད་ལཱ་ཡུན། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m063": "ནང་བསྐྱོད་གནད་སྡུད་སྦོམ་དྲགས་པས།",
  "m064": "བརྡ་འཚོལ་འདི་གིས་ ནང་བསྐྱོད་ཀུ་ཀི་ཅིག་མ་གཏང་པས། ས་ཁོངས་འདི་གི་དོན་ལུ་ ཀུ་ཀི་ཚུ་ གནང་བ་བྱིན་ཞིནམ་ལས་ ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m065": "ནང་བསྐྱོད་ཤོག་ལེབ་འདི་ དུས་ཡུན་ཚང་ཡོདཔ། ལཱ་ཡུན་གསརཔ་ཅིག་དང་གཅིག་ཁར་ ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m066": "ཧེ་མའི་ཞུ་བ་འདི་ ད་ལྟོ་ཡང་ ལཱ་འབད་བའི་བསྒང་ཡོདཔ་ཨིན། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m067": "OpenCode འདི་ བདག་སྐྱོང་ལས་འགན་ཚུ་ ལས་སྦྱོར་འབད་དོ་ཡོདཔ་ཨིན་ ཡང་ན་ ལོག་ཐོབ་དགོཔ་ཨིན། བསྒུག་ཞིནམ་ལས་ ལོག་སྟེ་ནང་བསྐྱོད་འབད་གནང་།",
  "m068": "འ་ནི་ IP ཁ་བྱང་འདི་ ནང་བསྐྱོད་འབད་ནི་གི་དཔའ་བཅམ་འཐུས་ཤོར་བྱུང་མི་ ༡༠ གི་ཤུལ་ལས་ བཀག་བཞག་ནུག། བདག་སྐྱོང་པ་ལུ་འབྲེལ་བ་འཐབ།",
  "m069": "བདེན་དཔྱད་ཨང་རྟགས་དེ་ འཛོལ་བ་ ཡང་ན་ དུས་ཡུན་ཚང་ཡོདཔ། ཨང་རྟགས་གསརཔ་བཙུགས་གནང་།",
  "m070": "ལག་ལེན་པའི་མིང་ ཡང་ན་ ཆོག་ཡིག་ནོར་འཁྲུལ་ཅན་ཨིན། འཐུས་ཤོར་བྱུང་བའི་དཔའ་བཅམ།: {0}/10.{1}",
  "m071": " བདེན་དཔྱད་ཨང་རྟགས་བཙུགས་གནང་།",
  "m072": "ནང་བསྐྱོད་འབད་བའི་སྐབས་ ལཱ་ཡུན་འདི་ ཆ་མེད་བཏང་ཡོདཔ་ཨིན། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m073": "ཉེན་སྲུང་ OpenCode རིམ་སྒྲིག་མངོན་གསལ་འབད་ནི་ལུ་འཐུས་ཤོར་བྱུང་ཡོདཔ། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m074": "OpenCode ངོས་འདྲ་བ་མངོན་གསལ་འབད་མ་ཚུགས། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m075": "OpenCode གནས་སྐབས་འཐོབ་མི་ཐུབ། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m076": "ལོག་སྟེ་ནང་བསྐྱོད་འབད་གནང་།",
  "m077": "ཤོག་ལེབ་འཚོལ་མ་ཐོབ།",
  "m078": "ཞུ་བ་མང་དྲགས། སྐར་མ་གཅིག་གི་ཤུལ་ལས་ ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m079": "ནུས་མེད་ཞུ་བ།",
  "m080": "ནུས་མེད་ཐབས་ལམ།",
  "m081": "བདག་སྐྱོང་ཞབས་ཏོག་ཚུ་ ལྕོགས་ཅན་མ་བཟོཝ་ཨིན། ལག་ལེན་འཐབ་ནིའི་དོན་ལུ་ ལི་ནགསི་གཞི་བཙུགས་པ་དང་གཅིག་ཁར་ ལོག་གཞི་བཙུགས་འབད།",
  "m082": "ནུས་མེད་ལཱ་ཡུན་བདེན་དཔང་། ཤོག་ལེབ་འདི་ལོག་མངོན་གསལ་འབད་གནང་།",
  "m083": "འཕྲོ་མཐུད་མ་འབད་བའི་ཧེ་མ་ ལོག་སྟེ་ནང་བསྐྱོད་འབད་ཞིནམ་ལས་ བདེན་དཔྱད་ཨང་རྟགས་འདི་བཙུགས་གནང་།",
  "m084": "བདག་སྐྱོང་ཞབས་ཏོག་ཚུ་ ལྕོགས་ཅན་མ་བཟོཝ་ཨིན།",
  "m085": "ཧེ་མའི་ཞུ་བ་འདི་ ད་ལྟོ་ཡང་ ལཱ་འབད་བའི་བསྒང་ཡོདཔ་ཨིན། བསྒུག་གནང་།",
  "m086": "ཞུ་བ་གནས་སྡུད་འདི་སྦོམ་དྲགས་པས།",
  "m087": "ནུས་མེད་གནད་སྡུད།",
  "m088": "བདེན་དཔྱད་ཨང་རྟགས་འདི་དུས་ཚོད་རྫོགས་ཡོདཔ།",
  "m089": "ནུས་མེད་འགྲུལ་ལམ།",
  "m090": "ནང་བསྐྱོད་ཤོག་ལེབ་བརྒྱུད་དེ་ ནང་བསྐྱོད་འབད།",
  "m091": "ནང་བསྐྱོད་འབད་གནང་།",
  "m092": "བདག་སྐྱོང་ཞབས་ཏོག་ཚུ་ གནས་སྐབས་ཅིག་ འཐོབ་མི་ཚུགས། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m093": "OpenCode འདི་འགོ་བཙུགས་དོ་ཡོདཔ་ཨིན་ ཡང་ན་ གནས་སྐབས་ཅིག་འཐོབ་མི་ཚུགས། ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m094": "བྱིན་མི་ཨའི་ཌི་ཚུ་ ཡིག་འབྲུ་ཆུང་བ་ཅིག་ལས་འགོ་བཙུགས་དགོཔ་དང་ ཡིག་འབྲུ་ཆུང་བ་དང་ཨང་གྲངས་ སྦྲེལ་རྟགས་ ཡང་ན་ འོག་ཐིག་ཚུ་རྐྱངམ་ཅིག་འོང་དགོཔ་ཨིན། མཐོ་ཤོས་ཡིག་འབྲུ་ ༦༣ ཡིན།",
  "m095": "ནུས་མེད་བྱིན་མི་མིང་; མཐོ་ཤོས་ཡིག་འབྲུ་ ༡༢༨ ཡོད།",
  "m096": "དང་ {0} དཔེ་ཚད་ཀྱི་བར་ན་གསལ་བཀོད་འབད།",
  "m097": "Model ID འདི་ནུས་མེད་ ཡང་ན་ འདྲ་བཤུས་རྐྱབ་ཡོདཔ་ཨིན།",
  "m098": "ནུས་མེད་དཔེ་ཚད་བཀྲམ་སྟོན་མིང་།",
  "m099": "རིམ་སྒྲིག་ཡིག་སྣོད་འདི་ ཝེབ་བརྒྱུད་དེ་ཞུན་དག་འབད་ནི་ལུ་ གནམ་མེད་ས་མེད་སྦོམ་འདུག།",
  "m100": "JSON/JSONC རིམ་སྒྲིག་ཡིག་སྣོད་ནང་འཛོལ་བ་ཚུ་ཡོདཔ་ཨིན། བསྒྱུར་བཅོས་གང་ཡང་བྲིས་མེད།",
  "m101": "རིམ་སྒྲིག་འདི་ གཏིང་ཟབ་དྲགས་སྦེ་ ནེསཊི་འབད་ཡོདཔ་ཨིན།",
  "m102": "རིམ་སྒྲིག་འདི་ནང་ འདྲ་བཤུས་ཡང་ན་ཉེན་སྲུང་མེད་པའི་ལྡེ་མིག་ཚུ་ཡོདཔ་ཨིན། བསྒྱུར་བཅོས་གང་ཡང་བྲིས་མེད།",
  "m103": "བྱིན་མི་ཚུ་གི་ས་སྒོ་འདི་དངོས་པོ་ཅིག་འོང་དགོ།",
  "m104": "རིམ་སྒྲིག་ཡིག་སྣོད་ ཡང་ན་ སྣོད་འཛིན་ལུ་ ཉེན་སྲུང་མེད་པའི་ གནང་བ་ཚུ་ཡོད།",
  "m105": "རིམ་སྒྲིག་གི་ སྣོད་ཐོ་ཨམ་དེ་ ཉེན་སྲུང་མེན།",
  "m106": "རིམ་སྒྲིག་ཡིག་སྣོད་དེ་ ཉེན་སྲུང་མེདཔ་ ཡང་ན་ སྦོམ་དྲགས་ཨིན་པས།",
  "m107": "ནུས་མེད་རིམ་སྒྲིག་འགྲུལ་ལམ།",
  "m108": "ནུས་མེད་རྒྱབ་ཐག་འགྲུལ་ལམ།",
  "m109": "ནུས་མེད་རིམ་སྒྲིག་རྒྱབ་སྐྱོར།",
  "m110": "ཡིག་སྣོད་དེ་ ས་གནས་གཞན་ཅིག་ནང་ བསྒྱུར་བཅོས་འབད་ནུག། དེ་བསྐྱར་འབྲི་འབད་ནི་ལས་ བཀག་ཐབས་ལུ་ སླར་གསོ་འབད་ནི་འདི་ ངོས་ལེན་མ་འབད་བས། སྒེར་གྱི་རྒྱབ་ཐག་ཚུ་བཞག་ཡོདཔ་ཨིན།",
  "m111": "རིམ་སྒྲིག་བསྒྱུར་བཅོས་འབད་ཡོདཔ། སྲུང་བཞག་མ་འབད་བའི་ཧེ་མ་ ཐོ་ཡིག་འདི་ཡང་བསྐྱར་མངོན་གསལ་འབད་གནང་།",
  "m112": "ནུས་མེད་བྱིན་མི་ཨའི་ཌི།",
  "m113": "བྱིན་མི་འདི་གིས་ རིམ་སྒྲིག་དབྱེ་བ་སོ་སོ་ཅིག་ལག་ལེན་འཐབ་ཨིནམ་དང་ ཨོ་པཱན་ཨེ་ཨའི་-མཐུན་འགྱུར་ཅན་གྱི་འབྲི་ཤོག་དང་གཅིག་ཁར་ཞུན་དག་འབད་མི་བཏུབ།",
  "m114": "བྱིན་མི་འདི་ལུ་ {0} དཔེ་ཚད་ལས་ལྷག་སྟེ་ཡོདཔ་ཨིན། དཔེ་ཚད་ཚུ་བྱང་སྟོར་ཤོར་མི་བཅུག་ནིའི་དོན་ལུ་ ཡིག་སྣོད་འདི་ཐད་ཀར་དུ་ཞུན་དག་འབད།",
  "m115": "རིམ་སྒྲིག་ཡིག་སྣོད་འདི་ནང་བྱིན་མི་འཚོལ་མ་ཐོབ།",
  "m116": "བྱིན་མི་འདི་སྔོན་སྒྲིག་དཔེ་ཚད་ཀྱིས་ལག་ལེན་འཐབ་ཨིན། བཏོན་མ་གཏང་པའི་ཧེ་མ་ སྔོན་སྒྲིག་དཔེ་ཚད་འདི་བསྒྱུར་བཅོས་འབད།",
  "m117": "སྔོན་སྒྲིག་སྦེ་གཞི་སྒྲིག་འབད་བའི་བསྒང་ཡོད་མི་དཔེ་ཚད་འདི་སེལ་འཐུ་མ་འབད་བས། དཔེ་ཚད་དེ་བཞག་གནང་ ཡང་ན་ མ་སྲུང་པའི་ཧེ་མ་ སྔོན་སྒྲིག་དཔེ་ཚད་བསྒྱུར་བཅོས་འབད་གནང་།",
  "m118": "Base URL བསྒྱུར་བཅོས་འབད་བའི་སྐབས་ ལྡེ་མིག་རྙིངམ་འདི་ཁ་བྱང་གསརཔ་ལུ་གཏང་ནི་ལས་ བཀག་ཐབས་ལུ་ API ལྡེ་མིག་འདི་ལོག་བཙུགས་ ཡང་ན་ རྩ་བསྐྲད་གཏང་།",
  "m119": "རིམ་སྒྲིག་འདི་ གཞན་ཁར་བསྒྱུར་བཅོས་འབད་ཡི། བསྒྱུར་བཅོས་གསརཔ་ཅིག་མ་བྲིས་པས།",
  "m120": "རིམ་སྒྲིག་སྲུང་བཞག་འབད་མ་ཚུགས། ཧེ་མའི་གནད་སྡུད་འདི་ སླར་གསོ་འབད་ནི་ལུ་ དཔའ་བཅམ་ཡོདཔ་ཨིན།",
  "m121": "རིམ་སྒྲིག་བསྒྱུར་བཅོས་འབད་ཡོདཔ། པར་ལེན་མ་འབད་བའི་ཧེ་མ་ ཐོ་ཡིག་འདི་ལོག་མངོན་གསལ་འབད་གནང་།",
  "m122": "བྱིན་མི་འདི་གིས་ ཚད་གཞི་གི་ OpenAI-མཐུན་སྒྲིག་རིམ་སྒྲིག་འདི་ལག་ལེན་འཐབ་མི་བཏུབ།",
  "m123": "Base URL བསྒྱུར་བཅོས་འབད་བའི་སྐབས་ དཔེ་ཚད་ཚུ་པར་ལོག་མ་བཏབ་པའི་ཧེ་མ་ API ལྡེ་མིག་འདི་ལོག་བཙུགས་ཡང་ན་བཏོན་གཏང་།",
  "m124": "ལྡེ་མིག་འདི་གིས་ ཚད་གཞི་འདི་གི་ཕྱི་ཁར་ཡོད་པའི་ཡིག་སྣོད་ཅིག་གཞི་བསྟུན་འབདཝ་ཨིན། དཔེ་ཚད་ཚུ་པར་ལོག་བཏབ་ནི་ལུ་ API ལྡེ་མིག་ཅིག་བཙུགས།",
  "m125": "ལྡེ་མིག་འདི་ OpenCode མཐའ་འཁོར་ལས་འོངམ་ཨིན། དཔེ་ཚད་ཚུ་པར་ལོག་བཏབ་ནི་ལུ་ API ལྡེ་མིག་ཅིག་བཙུགས།",
  "m126": "ཞིབ་ལྟ་འབད་བའི་སྐབས་ རིམ་སྒྲིག་བསྒྱུར་བཅོས་འབད་ཡི། ཐོ་ཡིག་འདི་ཡང་བསྐྱར་མངོན་གསལ་འབད།",
  "m127": "OpenCode ད་ལྟོ་གཡོག་བཀོལ་མི་བཏུབ།",
  "m128": "ད་ལྟོ་ཚད་གཞི་འདི་ནང་ལུ་ སྲོལ་སྒྲིག་བྱིན་མི་ཚུ་ལུ་ OpenCode v2 དགོཔ་ཨིན།",
  "m129": "OpenCode འདི་ ནང་ཐིག་རིམ་སྒྲིག་ལག་ལེན་འཐབ་དོ། ཚད་གཞི་བརྒྱུད་དེ་བྱིན་མི་འདི་ཞུན་དག་མ་འབད་བའི་ཧེ་མ་ ནང་ཐིག་རིམ་སྒྲིག་འདི་ཡིག་སྣོད་ལུ་གཞི་བསྒྱུར་འབད་གནང་།",
  "m130": "OpenCode རྩིས་ཐོ་དང་རིམ་སྒྲིག་སྣོད་ཐོ་གཏན་འབེབས་བཟོ་མ་ཚུགས།",
  "m131": "ཞབས་ཏོག་དང་གཅིག་ཁར་ བརྗེ་སོར་འབད་ཡོད་པའི་ གཏན་བཟོས་རྩ་བ་འཛིན་སྐྱོང་འཐབ་མི་འགྲུལ་ལམ་ནང་ npm (@opencode/cli ཡང་ན་ opencode-ai) དང་ཅིག་ཁར་ ཡོངས་ཁྱབ་སྦེ་གཞི་བཙུགས་འབད་ཡོད་མི་ 1.18.20 ལས་ OpenCode v2 ཡང་ན་ v1 དགོཔ་ཨིན།",
  "m132": "OpenCode ཐོན་རིམ་ལྷག་མི་ཚུགས། ཞབས་ཏོག་འདི་ཞིབ་དཔྱད་འབད་ ཡང་ན་ ད་ལྟོའི་ལས་ཀ་འདི་མཇུག་བསྡུ་ནི་ལུ་བསྒུག་སྡོད།",
  "m133": "ལས་འགན་འདི་ བར་ཆད་བྱུང་ཡོདཔ་ ཡང་ན་ དུས་ཚོད་རྫོགས་ཡོདཔ་ཨིན། ལོག་སྟེ་དཔའ་བཅམ་པའི་ཧེ་མ་ ཞབས་ཏོག་དང་རྒྱབ་ཐག་ཚུ་བརྟག་དཔྱད་འབད།",
  "m134": "ཆོག་ཡིག་ངེས་དཔྱད་འབད་ནིའི་དཔའ་བཅམ་མང་དྲགས། སྐར་མ་གཅིག་གི་ཤུལ་ལས་ ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m135": "ད་ལྟོའི་ཆོག་ཡིག་འདི་ནོར་འཁྲུལ་ཅན་ཨིན།",
  "m136": "GitHub ཞིབ་དཔྱད་འབད་མ་ཚུགས། ཤུལ་ལས་ལོག་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m137": "npm གུ་ OpenCode ཐོན་རིམ་གསརཔ་འདི་ ཞིབ་དཔྱད་འབད་མ་ཚུགས། ཤུལ་ལས་ལོག་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m138": "GitHub ལས་ཐོན་རིམ་ཐོ་ཡིག་ཕབ་ལེན་འབད་མ་ཚུགས། ཤུལ་ལས་ལོག་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m139": "བྱིན་མིའི་རིམ་སྒྲིག་ལྷག་མི་ཚུགས། ཡིག་སྣོད་གནང་བ་དང་ OpenCode ཞབས་ཏོག་ཚུ་ཞིབ་དཔྱད་འབད།",
  "m140": "ད་ལྟོའི་ཆོག་ཡིག་འདི་བསྒྱུར་བཅོས་འབད་ཡོདཔ་ཨིན། ལོག་སྟེ་ངེས་དཔྱད་འབད་གནང་།",
  "m141": "ཨའི་ཌི་འདི་ OpenCode ཡང་ན་ རིམ་སྒྲིག་གཞན་ཅིག་གིས་ ཧེ་མ་ལས་རང་ ལག་ལེན་འཐབ་དོ་ཡོདཔ་ཨིན། སྲོལ་སྒྲིག་ཨའི་ཌི་གསརཔ་ཅིག་སེལ་འཐུ་འབད་གནང་།",
  "m142": "རིམ་སྒྲིག་འདི་སྒེར་གྱི་ཐོག་ལས་སྲུང་བཞག་འབད་ཡོདཔ། reloading OpenCode དང་དཔེ་ཚད་བརྟག་དཔྱད་འབད་ནི།",
  "m143": "སྲོལ་སྒྲིག་བྱིན་མི་བཏོན་གཏང་ཞིནམ་ལས་ OpenCode རིམ་སྒྲིག་ལོག་མངོན་གསལ་འབད་ཡོདཔ།",
  "m144": "སྲོལ་སྒྲིག་བྱིན་མི་སྲུང་བཞག་འབད་ཡོདཔ་དང་དཔེ་ཚད་ཚུ་ OpenCode ནང་མཐོང་ཡོདཔ་ཨིན། དཔེ་ཚད་ཅིག་སེལ་འཐུ་འབད་ནི་ལུ་ ངོས་འདྲ་བ་འདི་ཡང་བསྐྱར་མངོན་གསལ་འབད།",
  "m145": "བྱིན་མི་ལུ་ འཇུག་སྤྱོད་འབད་མ་ཚུགས། ཧེ་མའི་རིམ་སྒྲིག་འདི་སླར་གསོ་འབད་ཡོདཔ་ཨིན།",
  "m146": "བྱིན་མི་ལུ་ འཇུག་སྤྱོད་འབད་མ་ཚུགས། སར་བར་གུ་རིམ་སྒྲིག་དང་སྒེར་གྱི་རྒྱབ་ཐག་ཚུ་ཞིབ་དཔྱད་འབད།",
  "m147": "བྱིན་མི་སྲུང་བཞག་འབད་མ་ཚུགས། རིམ་སྒྲིག་འདི་ཞིབ་དཔྱད་འབད་ཞིནམ་ལས་ ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད།",
  "m148": "བདག་སྐྱོང་ལས་འགན་ཅིག་ལས་སྦྱོར་འབད་དོ། བསྒུག་གནང་།",
  "m149": "ད་ལྟོ་ཚུན་ཚོད་ འོས་འབབ་ཅན་གྱི་ གསརཔ་ཅིག་ བཏོན་མ་ཚུགས།",
  "m150": "དུས་མཐུན་བཟོ་ནི་གྲ་སྒྲིག་འབད་དོ།",
  "m151": "དུས་མཐུན་བཟོ་མི་འགོ་བཙུགས་མི་ཚུགས་པས། བདག་སྐྱོང་ཞབས་ཏོག་ལུ་བལྟ་གནང་།",
  "m152": "དུས་མཐུན་བཟོ་མི་འགོ་བཙུགས་མི་ཚུགས་པས།",
  "m153": "དུས་མཐུན་བཟོ་ནི་འགོ་བཙུགས་ཡོདཔ། ཞབས་ཏོག་ལོག་འགོ་བཙུགསཔ་ད་ ཤོག་ལེབ་འདི་མཐུད་ལམ་བཏོག་འོང་།",
  "m154": "ནུས་མེད་བཀོལ་སྤྱོད།",
  "m155": "དཔེ་ཚད་ཚུ་པར་ལོག་བཏབ་དོ། བསྒུག་གནང་།",
  "m156": "སྐར་མ་རེ་ལུ་ དཔེ་ཚད་ ༦ ཚུན་ པར་ལེན་འབད། བསྒུག་སྟེ་ ལོག་སྟེ་འབད་རྩོལ་བསྐྱེད་གནང་།",
  "m157": "དཔེ་ཚད་ཚུ་པར་ལེན་མ་འབད་བའི་ཧེ་མ་ ཐོ་ཡིག་འདི་ལོག་མངོན་གསལ་འབད།",
  "m158": "དཔེ་ཚད་ཚུ་པར་ལོག་བཏབ་མི་ཚུགས། མཐུད་ལམ་དང་བྱིན་མི་རིམ་སྒྲིག་ཞིབ་དཔྱད་འབད།",
  "m159": "ཐོ་ཡིག་འདི་ལོག་མངོན་གསལ་འབད་ཞིནམ་ལས་ OpenCode རིམ་སྒྲིག་འདི་ལོག་མངོན་གསལ་འབད་ནི་ལུ་ ཁྱོད་རའི་གན་ཡིག་འདི་ངེས་དཔྱད་འབད་གནང་།",
  "m160": "བྱིན་མི་འདི་གི་དོན་ལུ་ OpenCode རིམ་སྒྲིག་གཏན་འབེབས་བཟོ་མ་ཚུགས།",
  "m161": "བྱིན་མི་བཏོན་གཏང་ནི་དང་ OpenCode རིམ་སྒྲིག་ལོག་མངོན་གསལ་འབད་དོ།",
  "m162": "སྲོལ་སྒྲིག་བྱིན་མི་འདི་རྒྱབ་ཐག་དང་སྲུང་བཞག་འབད་དོ།",
  "m163": "ཞུ་བ་ཐོབ་ཡོད། ཤོག་ལེབ་འདི་གིས་ OpenCode རིམ་སྒྲིག་སྲུང་བཞག་འབད་ནི་དང་ ལོག་མངོན་གསལ་འབད་ནི་ཚུ་ བལྟ་བརྟོག་འབད་འོང་།",
  "m164": "ཁྱོད་ཀྱི་ལཱ་འདི་སྲུངས་ཡོདཔ་ངེས་དཔྱད་འབད་ཞིནམ་ལས་ OpenCode ལོག་འགོ་བཙུགས་ནི་ལུ་ངོས་ལེན་འབད་གནང་།",
  "m165": "སེལ་འཐུ་འབད་ཡོད་པའི་ཐོན་རིམ་དེ་ ནུས་མེད་ ཡང་ན་ རྒྱབ་སྐྱོར་མ་འབད་བས།",
  "m166": "ཐོན་རིམ་འདི་གཞུང་འབྲེལ་གསར་བཏོན་ཐོ་ཡིག་ནང་མེད། ཐོ་འདི་ཡང་བསྐྱར་ཞིབ་དཔྱད་འབད་གནང་།",
  "m167": "OpenCode གིས་ སེལ་འཐུ་འབད་ཡོད་པའི་ཐོན་རིམ་འདི་གཞི་བཙུགས་འབད་ཡོདཔ་ཨིན།",
  "m168": "{0} OpenCode ལས་ {1} ཚུན་གྲ་སྒྲིག་འབད་དོ།",
  "m169": "གནས་རིམ་མར་ཕབ་པ།",
  "m170": "དུས༌མཐུན༌བཟོ༌ནི༌",
  "m171": "གཞི་བཙུགས་འབད་ཡོད་པའི་ཐོན་རིམ་ལག་ལེན་འཐབ་ནི་ལུ་ OpenCode ལོག་འགོ་བཙུགས་ནི་ལུ་གྲ་སྒྲིག་འབད་དོ།",
  "m172": "OpenCode དུས་མཐུན་བཟོ་མི་འགོ་བཙུགས་མི་ཚུགས།",
  "m173": "OpenCode ལས་འགན་འགོ་བཙུགས་ཡོདཔ། ཞབས་ཏོག་ལོག་འགོ་བཙུགས་པའི་ཤུལ་ལས་ ཤོག་ལེབ་འདི་གིས་ གྲུབ་འབྲས་འདི་ཞིབ་དཔྱད་འབད་འོང་།",
  "m174": "ནུས་མེད་དུས་མཐུན་རིམ་སྒྲིག།",
  "m175": "དུས་མཐུན་སྒྲིག་སྟངས་ཚུ་སྲུང་བཞག་འབད་ཡོདཔ།",
  "m176": "ཆོག་ཡིག་གསརཔ་འདི་ ཆོག་ཡིག་རྙིངམ་ལས་སོ་སོ་སྦེ་ ཡིག་འབྲུ་༡༦ དང་༡༢༨ གི་བར་ན་དགོཔ་དང་ ངེས་དཔྱད་སྒྲོམ་དང་མཐུན་སྒྲིག་འབད་དགོ།",
  "m177": "ཆོག་ཡིག་བསྒྱུར་བཅོས་འབད་ནི་དང་ OpenCode ལོག་འགོ་བཙུགས་དོ།",
  "m178": "ཆོག་ཡིག་བསྒྱུར་བཅོས་འབད་ཡོདཔ། ལོག་སྟེ་ནང་བསྐྱོད་འབད་གནང་།",
  "m179": "ཆོག་ཡིག་བསྒྱུར་བཅོས་འབད་མ་ཚུགས། སར་བར་གུ་རིམ་སྒྲིག་དང་རྒྱབ་ཐག་ཚུ་ཞིབ་དཔྱད་འབད།",
  "m180": "ཆོག་ཡིག་བསྒྱུར་བཅོས་འབད་དོ། ལོག་འགོ་བཙུགས་ནི་ལུ་ OpenCode བསྒུག་ཞིནམ་ལས་ ཆོག་ཡིག་གསརཔ་དང་གཅིག་ཁར་ ནང་བསྐྱོད་འབད།",
  "m181": "ཆོག་ཡིག་སོར་ནིའི་ལས་འགན་དེ་ བར་ཆད་བྱུང་ནུག། ཞབས་ཏོག་འདི་ཞིབ་དཔྱད་འབད་ཞིནམ་ལས་ ལོག་སྟེ་ནང་བསྐྱོད་འབད།",
  "m182": "བྱིན་མི་ལས་འགན་འདི་ བར་ཆད་བྱུང་ནུག། རིམ་སྒྲིག་ཞིབ་དཔྱད་འབད་ནི་ལུ་ ཐོ་ཡིག་འདི་ལོག་མངོན་གསལ་འབད། སྒེར་གྱི་རྒྱབ་ཐག་ཚུ་ད་ལྟོ་ཡང་བཞག་སྟེ་ཡོདཔ་ཨིན།",
  "m183": "བདག་སྐྱོང་ཞབས་ཏོག་ཚུ་ གནས་སྐབས་ཅིག་ འཐོབ་མི་ཚུགས།",
  "m184": "དུས་མཐུན་ཐུམ་སྒྲིལ་ཕབ་ལེན་དང་ཞིབ་དཔྱད་འབད་དོ།",
  "m185": "Web Login Module ལས་ {0} ཚུན་དུས་མཐུན་བཟོ་ཡོདཔ།",
  "m186": "དུས་མཐུན་བཟོ་མ་ཚུགས། ད་ལྟོའི་གཞི་བཙུགས་འདི་བདག་འཛིན་འཐབ་ཡོདཔ་ཡང་ན་སླར་གསོ་འབད་ཡོདཔ་ཨིན། སར་བར་གུ་རྒྱབ་ཐག་འདི་ཞིབ་དཔྱད་འབད།",
  "m187": "ཞབས་ཏོག་མ་བཀག་པའི་ཧེ་མ་ OpenCode ཐུམ་སྒྲིལ་མངོན་གསལ་འབད་ནི་དང་ཞིབ་དཔྱད་འབད་དོ།",
  "m188": "གནད་སྡུད་རྒྱབ་ཐག་དང་ OpenCode ལོག་འགོ་བཙུགས་དོ།",
  "m189": "OpenCode འདི་ཐོན་རིམ་ {0} གཡོག་བཀོལ་དོ།",
  "m190": "དུས་མཐུན་ OpenCode འཐུས་ཤོར་བྱུང་ཡོད། ཧེ་མའི་གཞི་བཙུགས་དང་ གནད་སྡུད་ཚུ་ བདག་འཛིན་འཐབ་ཡོདཔ་ ཡང་ན་ སོར་ཆུད་འབད་ཡོདཔ་ཨིན།",
  "m191": "OpenCode དུས་མཐུན་བཟོ་མ་ཚུགས།; སླར་གསོ་མ་གྲུབ་པས། སར་བར་གུ་རྒྱབ་ཐག་ཞིབ་དཔྱད་འབད་ནི་ལུ་ བདག་སྐྱོང་པ་ཅིག་དགོཔ་ཨིན།",
  "m192": "གྲ་སྒྲིག་འབད་བའི་སྐབས་ ལས་འགན་བར་ཆད་བྱུང་ཡོདཔ། གཞི་བཙུགས་དང་ཞབས་ཏོག་རྙིངམ་ཚུ་ད་ལྟོ་ཡང་ལཱ་འབདཝ་ཨིན། ཁྱོད་ཀྱིས་དུས་མཐུན་མ་བཟོ་བའི་ཧེ་མ་ ལོག་སྟེ་ཞིབ་དཔྱད་འབད་ཚུགས།",
  "m193": "སླར་གསོ་འབད་ཡོདཔ་ OpenCode དང་ རྒྱབ་ཐག་ལས་གནད་སྡུད། ཁྱོད་ཀྱིས་དུས་མཐུན་མ་བཟོ་བའི་ཧེ་མ་ ལོག་སྟེ་ཞིབ་དཔྱད་འབད་ཚུགས།",
  "m194": "སླར་གསོ་འབད་ནི་འདི་མཇུག་མ་བསྡུ་བས། སར་བར་གུ་ཡོད་པའི་ཞབས་ཏོག་དང་རྒྱབ་ཐག་ཚུ་ཞིབ་དཔྱད་འབད་དགོཔ་ཨིན།",
  "m195": "རིམ་སྒྲིག་གནད་སྡུད་འདི་སྦོམ་དྲགས་པས།",
